{
  "name": "civic-godstorm",
  "version": "0.0.0-m00",
  "private": true,
  "description": "CIVIC GODSTORM - offline-first browser 4X with a directly controlled colossal God (contract CG-V1.0.0).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.6.0"
  },
  "scripts": {
    "dev": "vite",
    "spec:compile": "node tools/spec/compile-spec.ts",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint --max-warnings=0 .",
    "test:unit": "vitest run --project unit",
    "test:sim": "vitest run --project sim",
    "test:assets": "node tools/assets/check-assets.ts",
    "test:e2e": "npm run build && playwright test",
    "test:campaigns": "node tools/runners/campaigns.ts",
    "bench": "node tools/runners/bench.ts",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "validate:release": "node tools/assets/validate-release.ts",
    "probe:env": "node tools/env/probe.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
